---
const {
  title = "AIニュースコンパス",
  description = "AIニュースとAIツール情報を日本語でわかりやすく整理するメディア"
} = Astro.props;

import "../styles/global.css";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${basePath}${path.replace(/^\//, "")}`;

const today = new Date().toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "short"
});

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-date">{today}</div>
      <div class="masthead">
        <a href={withBase("/")}>AIニュースコンパス</a>
      </div>
      <div class="header-subtitle">AIニュースとAIツール情報を、毎日の判断に使いやすく。</div>
      <hr class="header-rule-double" />
      <hr class="header-rule-single" />
      <nav class="site-nav">
        <a href={withBase("/")} class={currentPath === basePath || currentPath === "/" ? "active" : ""}>ホーム</a>
        <a href={withBase("/about/")} class={currentPath.includes("/about") ? "active" : ""}>運営情報</a>
        <a href={withBase("/privacy/")} class={currentPath.includes("/privacy") ? "active" : ""}>プライバシー</a>
        <a href={withBase("/contact/")} class={currentPath.includes("/contact") ? "active" : ""}>お問い合わせ</a>
      </nav>
      <hr class="nav-rule" />
    </header>

    <slot />

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} AIニュースコンパス</p>
      <p>AIニュースとAIツール情報を、毎日の判断に使いやすく。</p>
    </footer>
  </body>
</html>
